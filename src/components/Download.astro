---
interface Props {
  version: string
}
const { version } = Astro.props

const repo = 'https://github.com/verastack-labs/rigseed-app'
const tag = `v${version}`
const asset = (file: string) => `${repo}/releases/download/${tag}/${file}`

/*
 * Asset names are derived from one version constant rather than pasted, so a
 * release bump is one edit and the links cannot disagree with each other.
 *
 * Every asset has a .sha256 beside it on the release, generated by the same
 * workflow that built the installer. Those are linked rather than inlined:
 * inlining means the page carries five hashes that must be updated in lockstep
 * with every release, and a stale hash on a download page is worse than no
 * hash, because it reads as tampering to anyone who checks.
 */
const platforms = [
  {
    name: 'Windows',
    detail: '10 and 11, 64-bit',
    files: [
      { label: 'Installer (.exe)', file: `rigseed_${version}_x64-setup.exe`, primary: true },
      { label: 'MSI package', file: `rigseed_${version}_x64_en-US.msi` },
    ],
    verify: `certutil -hashfile rigseed_${version}_x64-setup.exe SHA256`,
    warning:
      'Windows will show "Windows protected your PC" because the build is not signed. Choose More info, then Run anyway.',
  },
  {
    name: 'macOS',
    detail: 'Apple Silicon only',
    files: [{ label: 'Disk image (.dmg)', file: `rigseed_${version}_aarch64.dmg`, primary: true }],
    verify: `shasum -a 256 rigseed_${version}_aarch64.dmg`,
    warning:
      'Not notarised, so Gatekeeper refuses it on a first open. Right-click the app and choose Open, then confirm. This build has been checked but never launched on a Mac.',
  },
  {
    name: 'Linux',
    detail: 'x86-64, glibc 2.35 or newer',
    files: [
      { label: 'Debian package (.deb)', file: `rigseed_${version}_amd64.deb`, primary: true },
      { label: 'RPM package', file: `rigseed-${version}-1.x86_64.rpm` },
    ],
    verify: `sha256sum rigseed_${version}_amd64.deb`,
    warning:
      'Built against glibc 2.35, so Ubuntu 22.04 and Debian 12 and newer are covered. Older distributions will not start the daemon.',
  },
]
---

<section id="download" class="wrap">
  <p class="eyebrow">Download</p>
  <h2>rigseed {tag}</h2>
  <p class="lede">
    qBittorrent is bundled, so there is nothing else to install. The first launch generates its own
    credentials and starts the daemon on a profile of its own, which never touches a qBittorrent you
    already run.
  </p>

  <div class="grid">
    {
      platforms.map((p) => (
        <article class="card">
          <header>
            <h3>{p.name}</h3>
            <span class="detail mono">{p.detail}</span>
          </header>

          <div class="files">
            {p.files.map((f) => (
              <a class={f.primary ? 'btn primary' : 'btn'} href={asset(f.file)}>
                {f.label}
              </a>
            ))}
          </div>

          <p class="warning">{p.warning}</p>

          <details>
            <summary>Verify the download</summary>
            <p class="verify-note">
              Nothing here is signed, so the checksum is the only way to tell this is the file the
              build produced. Compare the output against
              <a href={`${asset(p.files[0].file)}.sha256`}>{p.files[0].file}.sha256</a> on the
              release.
            </p>
            {/*
              Kept on one line. <pre> preserves whitespace, so reflowing this
              indents the command by however deep the markup happens to sit,
              and the reader sees a command they cannot copy cleanly. The
              directive below has to read exactly "prettier-ignore" with
              nothing after it, which is why this explanation is separate.
            */}
            {/* prettier-ignore */}
            <pre class="mono"><code>{p.verify}</code></pre>
          </details>
        </article>
      ))
    }
  </div>

  <p class="foot">
    Every asset on the release carries a matching <code>.sha256</code>, written by the workflow that
    built it. The release also carries the corresponding source for the bundled qBittorrent, which
    is what its licence requires and why it is offered from the same page as the binary.
    <a href={`${repo}/releases/latest`}>See all files on the release</a>.
  </p>
</section>

<style>
  .lede {
    margin-top: 1rem;
    max-width: 52ch;
  }

  h2 {
    font-family: 'Inter Variable', sans-serif;
  }

  .grid {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2rem, 5vw, 3rem);
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }

  .card {
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .detail {
    color: var(--text-dimmer);
    font-size: 0.6875rem;
  }

  .files {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .btn {
    display: block;
    text-align: center;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--line);
    border-radius: var(--r-control);
    background: var(--surface2);
    color: var(--text);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color var(--t-fast) ease;
  }

  .btn:hover {
    background: color-mix(in srgb, var(--accent) 14%, var(--surface2));
  }

  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-on);
  }

  .btn.primary:hover {
    background: color-mix(in srgb, var(--accent) 88%, var(--text));
  }

  /* The warning uses --warn, never the accent. Several accents pair with a
     terracotta secondary that would be indistinguishable from danger, which is
     why status colour is fixed per mode and independent of the theme. */
  .warning {
    font-size: 0.8125rem;
    color: var(--text-dim);
    border-left: 2px solid var(--warn);
    padding-left: 0.75rem;
    margin: 0;
  }

  details {
    margin-top: auto;
    font-size: 0.8125rem;
  }

  summary {
    cursor: pointer;
    color: var(--text-dim);
    padding: 0.25rem 0;
  }

  summary:hover {
    color: var(--text);
  }

  .verify-note {
    color: var(--text-dim);
    margin: 0.5rem 0;
  }

  pre {
    margin: 0;
    padding: 0.625rem 0.75rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--r-control);
    overflow-x: auto;
  }

  code {
    color: var(--text-dim);
    font-size: 0.75rem;
  }

  .foot {
    margin-top: 1.75rem;
    color: var(--text-dim);
    font-size: 0.875rem;
    max-width: 62ch;
  }
</style>
