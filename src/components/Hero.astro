---
import { Image } from 'astro:assets'
import dark from '../assets/screens/02-transfers-dark.png'

const base = import.meta.env.BASE_URL

// Voice: plain, factual, slightly technical. Sentence case throughout, no
// exclamation marks, no encouragement. rigseed is lowercase always, including
// sentence-initial, so the h1 starts lowercase on purpose.
const version = 'v0.1.1'
---

<header class="hero">
  <div class="wrap inner">
    {
      /*
      The status pill carries the two facts a visitor needs before anything
      else: what version this is and whether it runs on their machine. The dot
      is the app's own "connected" indicator, which is the only live state the
      site has to report.
    */
    }
    <p class="pill">
      <span class="dot" aria-hidden="true"></span>
      {version} · Windows, macOS and Linux
    </p>

    <h1>rigseed puts a modern interface on the daemon you already trust.</h1>

    <p class="lede">
      It drives qBittorrent over the Web API the daemon already exposes. The engine underneath is
      unchanged, so nothing about how your torrents run is new. Only the part you look at.
    </p>

    <div class="actions">
      <a class="btn primary" href={`${base}/download/`}>Download {version}</a>
      <a class="btn" href={`${base}/screens/`}>See the screens</a>
    </div>

    <!-- The API is visible. Every screen in the app prints the endpoints it
         exercises, and the site keeps the habit rather than dropping it at the
         marketing boundary. -->
    <p class="endpoints mono">sync/maindata · torrents/info · app/preferences</p>
  </div>

  {
    /*
    The surface runs off the bottom of the hero rather than sitting in a
    finished box. The crop is the argument: the app is bigger than the frame
    the page gave it, and the reader scrolls to see the rest.
  */
  }
  <div class="stage-wrap">
    <div class="stage">
      <Image
        src={dark}
        alt="rigseed showing six torrents in grid view, with a sidebar of status filters, categories and tags, and a live download and upload graph."
        {/*
          The container is 62rem, so a 2x display needs 1984 physical pixels and
          a 3x one needs nearly 3000. Capping the srcset at 1440w made the
          browser take that file and upscale it, which is what made the first
          version look soft: the capture was always 2880 wide, the widths list
          was not.

          quality 90 rather than the default 80. This is flat UI with 1px
          borders and small mono type, where webp's default ringing shows on
          every rule, and the file is only a few tens of kB either way.
        */}
        widths={[720, 1080, 1440, 2048, 2880]}
        sizes="(min-width: 68rem) 62rem, 100vw"
        quality={90}
        loading="eager"
        fetchpriority="high"
        class="shot"
      />
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    /* No bottom padding. The surface is meant to meet the next section, not
       float above a gap. */
    padding-block: clamp(3.5rem, 8vw, 6rem) 0;
    overflow: hidden;
  }

  /* The accent, very dilute, behind the fold. It reads as the surface being
     tinted rather than as a gradient sitting on top of it. */
  .hero::before {
    content: '';
    position: absolute;
    inset: -22rem 0 auto;
    height: 60rem;
    background: radial-gradient(
      46% 38% at 50% 50%,
      color-mix(in srgb, var(--accent) 15%, transparent),
      transparent 72%
    );
    pointer-events: none;
    z-index: -1;
  }

  .inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.75rem;
    padding: 0.3rem 0.75rem 0.3rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    color: var(--text-dim);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    letter-spacing: -0.01em;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 18%, transparent);
  }

  h1 {
    /* Three lines at the desktop size. The measure is what gives the block its
       shape, so it is set here rather than left to the viewport. */
    max-width: 19ch;
  }

  .lede {
    margin-top: 1.5rem;
    max-width: 52ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.35rem;
    border: 1px solid var(--line);
    border-radius: var(--r-control);
    background: var(--surface);
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color var(--t-fast) ease,
      border-color var(--t-fast) ease,
      transform var(--t-fast) var(--spring);
  }

  .btn:hover {
    background: var(--surface2);
    transform: translateY(-1px);
  }

  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-on);
  }

  .btn.primary:hover {
    background: color-mix(in srgb, var(--accent) 88%, var(--text));
  }

  .endpoints {
    margin-top: 1.75rem;
    color: var(--text-dimmer);
    font-size: 0.75rem;
  }

  .stage-wrap {
    width: min(100% - 2.5rem, 62rem);
    margin: clamp(3rem, 7vw, 4.5rem) auto 0;
  }

  /* 16/9 against a 16/10 capture, so the bottom tenth of the window is cut by
     the frame. Small enough to read as a crop rather than as a missing piece. */
  .stage {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: var(--r-card) var(--r-card) 0 0;
    background: var(--surface);
    /* The aura. Accent-tinted rather than black, so the image sits in a pool
       of its own colour instead of on a drop shadow. */
    box-shadow:
      0 -1px 0 color-mix(in srgb, var(--text) 6%, transparent) inset,
      0 2rem 5rem color-mix(in srgb, var(--accent) 20%, transparent);
  }

  .shot {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 48rem) {
    /* The crop costs more than it says at this width, where the window is
       already small. Show the whole capture. */
    .stage {
      aspect-ratio: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }
    .btn:hover {
      transform: none;
    }
  }
</style>
