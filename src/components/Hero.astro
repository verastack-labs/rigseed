---
import { VERSION } from '../consts'
import { Image } from 'astro:assets'
import HeroAmbient from './HeroAmbient.astro'
import dark from '../assets/screens/02-transfers-dark.png'

const base = import.meta.env.BASE_URL

// Voice: plain, factual, slightly technical. Sentence case throughout, no
// exclamation marks, no encouragement. rigseed is lowercase always, including
// sentence-initial, so the h1 starts lowercase on purpose.
const version = `v${VERSION}`
---

<header class="hero">
  <HeroAmbient />

  <div class="wrap inner">
    {
      /*
      The status pill carries the two facts a visitor needs before anything
      else: what version this is and whether it runs on their machine. The dot
      is the app's own "connected" indicator, which is the only live state the
      site has to report.
    */
    }
    <p class="pill">
      <span class="dot" aria-hidden="true"></span>
      {version} · Windows, macOS and Linux
    </p>

    {
      /*
      Three levels, and the order is the argument.

      The headline is for somebody who has never heard of this and is deciding
      within a second whether to keep reading. It says the noun, torrents,
      which the old opening never did: that led with "the daemon you already
      trust", which means something only to a reader who already runs one.

      The line under it is the old headline, demoted rather than deleted. It is
      the honest technical claim and it still belongs above the fold, just not
      first. The name keeps the script, so the rule that Yellowtail is reserved
      for the product's name holds wherever the name moves to.

      The smallest line is the qBittorrent relationship, which matters
      enormously to a reader who knows what that is and not at all to one who
      does not, so it is sized for the first without taxing the second.
    */
    }
    {
      /*
      One coloured run, and only one. Eight accents exist to drive it, it
      retints with everything else, and it is the cheapest characterful gesture
      this world owns: the headline was a uniform white slab without it.
    */
    }
    <h1>Torrents, <em>finally worth looking at.</em></h1>

    <p class="sub">
      <span class="name-script">rigseed</span> puts a modern interface on the daemon you already trust.
    </p>

    <p class="fine">The reliability of qBittorrent, with the interface it never had.</p>

    <div class="actions">
      <a class="btn primary" href={`${base}/download/`}>Download {version}</a>
      <a class="btn" href={`${base}/screens/`}>See the screens</a>
    </div>

    <!-- The API is visible. Every screen in the app prints the endpoints it
         exercises, and the site keeps the habit rather than dropping it at the
         marketing boundary. -->
    <p class="endpoints mono">sync/maindata · torrents/info · app/preferences</p>
  </div>

  {
    /*
    The surface is shown whole and tilted back, then straightens as you scroll.
    It was cropped to 16/9 before, which cut the floating action button off the
    bottom right corner: the crop was removing a real control from a picture
    whose entire job is showing the real thing. Laying it back instead keeps
    every pixel of the capture and still gives the section something to do
    between the fold and the next heading.
  */
  }
  <div class="stage-wrap" data-stage-wrap>
    <div class="stage" data-stage>
      <Image
        src={dark}
        alt="rigseed showing six torrents in grid view, with a sidebar of status filters, categories and tags, and a live download and upload graph."
        {/*
          The container is 62rem, so a 2x display needs 1984 physical pixels and
          a 3x one needs nearly 3000. Capping the srcset at 1440w made the
          browser take that file and upscale it, which is what made the first
          version look soft: the capture was always 2880 wide, the widths list
          was not.

          quality 90 rather than the default 80. This is flat UI with 1px
          borders and small mono type, where webp's default ringing shows on
          every rule, and the file is only a few tens of kB either way.
        */}
        widths={[720, 1080, 1440, 2048, 2880]}
        sizes="(min-width: 68rem) 62rem, 100vw"
        quality={90}
        loading="eager"
        fetchpriority="high"
        class="shot"
      />
    </div>
  </div>
</header>

<script>
  /*
   * Re-run on every navigation, because the router keeps this module alive across page changes and the element it drives is replaced underneath it.
   *
   * astro:page-load fires at the end of the first load and after every
   * client-side navigation, which is the only hook needed. Listeners are hung
   * off an AbortController that is torn down first, so navigating back and
   * forth cannot leave a stack of handlers behind on window or document.
   */
  let controller: AbortController | null = null

  const setup = () => {
    controller?.abort()
    controller = new AbortController()
    const { signal } = controller

    /*
     * The capture lies back at rest and stands up as you scroll past it.
     *
     * Driven from scrollY against a fixed range rather than from the element's
     * own intersection, because the element is in the first viewport on load and
     * an observer-based version has nothing to observe until the reader has
     * already moved. The starting angle is small enough that the screenshot is
     * completely legible before anybody scrolls at all, which is the point: this
     * is a resting state, not a reveal waiting to be triggered.
     */
    const stage = document.querySelector<HTMLElement>('[data-stage]')
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)')
    const narrow = window.matchMedia('(max-width: 48rem)')

    if (stage && !calm.matches) {
      const START = 14
      const RANGE = 420

      let ticking = false
      const update = () => {
        ticking = false
        if (narrow.matches) {
          stage.style.removeProperty('--tilt')
          return
        }
        const t = Math.min(window.scrollY / RANGE, 1)
        // Eased out, so most of the straightening happens early and the last few
        // degrees do not drag on for another two hundred pixels.
        const eased = 1 - Math.pow(1 - t, 2)
        stage.style.setProperty('--tilt', String(START * (1 - eased)))
      }

      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return
          ticking = true
          requestAnimationFrame(update)
        },
        { passive: true, signal },
      )
      window.addEventListener('resize', update, { signal })
      update()
    }
  }

  document.addEventListener('astro:page-load', setup)
</script>

<style>
  .hero {
    position: relative;
    /* The surface is a finished object again rather than something running off
       an edge, so the section closes properly underneath it. */
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(3rem, 7vw, 5rem);
    overflow: hidden;
  }

  /* The accent, very dilute, behind the fold. It reads as the surface being
     tinted rather than as a gradient sitting on top of it. */
  .hero::before {
    content: '';
    position: absolute;
    inset: -22rem 0 auto;
    height: 60rem;
    background: radial-gradient(
      46% 38% at 50% 50%,
      color-mix(in srgb, var(--accent) 15%, transparent),
      transparent 72%
    );
    pointer-events: none;
    z-index: -1;
  }

  .inner {
    /* Above the ambient layer, which is absolutely positioned at z-index 0
       across the whole section. */
    position: relative;
    z-index: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Not italic. em is the right element for a run the sentence stresses, and
     the emphasis is carried by colour here rather than by slant. */
  h1 em {
    font-style: normal;
    color: var(--accent);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.75rem;
    padding: 0.3rem 0.75rem 0.3rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    color: var(--text-dim);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    letter-spacing: -0.01em;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 18%, transparent);
  }

  h1 {
    /* Bigger than the base scale, because it is carrying the whole first
       impression now. The measure holds it to two lines. */
    font-size: clamp(2.6rem, 7vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    max-width: 16ch;
  }

  .sub {
    margin-top: 1.5rem;
    max-width: 40ch;
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--text-dim);
  }

  /* The relationship to qBittorrent, sized for the reader it means something
     to rather than for everybody else. */
  .fine {
    margin-top: 1.1rem;
    max-width: 52ch;
    font-size: 0.8125rem;
    color: var(--text-dimmer);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .endpoints {
    margin-top: 1.75rem;
    color: var(--text-dimmer);
    font-size: 0.75rem;
  }

  .stage-wrap {
    position: relative;
    z-index: 1;
    width: min(100% - 2.5rem, 62rem);
    margin: clamp(3rem, 7vw, 4.5rem) auto 0;
  }

  .stage-wrap {
    /* The vanishing point. Far enough back that the tilt reads as depth rather
       than as a fisheye, which is what a short perspective does to something
       this wide. */
    perspective: 2200px;
  }

  .stage {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface);
    /* Hinged along its top edge, so it stands up rather than pivoting about
       its middle. --tilt is written by the scroll handler. */
    transform-origin: 50% 0%;
    transform: rotateX(calc(var(--tilt, 14) * 1deg));
    will-change: transform;
    /*
     * Three layers, and the middle one was missing.
     *
     * The inset highlight is the light catching the top edge. The accent pool
     * is the aura. Between them belongs an actual offset shadow: a halo with
     * no offset makes a slab glow rather than sit in space, and with the
     * surface now tilted back it is the shadow that sells the tilt. Long,
     * soft, and pulled in at the sides so it falls under rather than around.
     */
    box-shadow:
      0 -1px 0 color-mix(in srgb, var(--text) 8%, transparent) inset,
      0 2.25rem 3.5rem -1.5rem var(--shadow-color),
      0 2rem 5rem color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .shot {
    width: 100%;
    height: auto;
    display: block;
  }

  /* No tilt where it would cost more than it gives: a narrow screen is mostly
     scroll and the foreshortening eats the small type, and under reduced
     motion a transform driven by scroll position is precisely the thing being
     opted out of. Both land on the flat, finished state. */
  @media (max-width: 48rem), (prefers-reduced-motion: reduce) {
    .stage {
      transform: none;
    }
  }
</style>
