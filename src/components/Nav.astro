---
import Wordmark from './Wordmark.astro'

const base = import.meta.env.BASE_URL

// Source leaves the site, so it can never be the current page and must not be
// a target the indicator can rest on.
const pages = [
  { href: `${base}/`, label: 'Home' },
  { href: `${base}/screens/`, label: 'Screens' },
  { href: `${base}/download/`, label: 'Download' },
]

// Astro emits trailing slashes, but a link typed without one still resolves,
// so both forms have to count as the same page.
const here = Astro.url.pathname.replace(/\/+$/, '') || base
const isCurrent = (href: string) => href.replace(/\/+$/, '') === here
---

<header class="nav" data-nav>
  <div class="wrap bar">
    <Wordmark size={1.45} />

    <nav class="links" aria-label="Primary" data-links>
      {
        /*
        The indicator rests under the current page and slides to whichever link
        is hovered, then returns. It is the app's own View control, which
        slides between Easy, Grid and List the same way; borrowed from the
        product rather than from a trend.
      */
      }
      <span class="indicator" data-indicator aria-hidden="true"></span>
      {
        pages.map((p) => (
          <a
            href={p.href}
            data-page
            class:list={{ 'is-current': isCurrent(p.href) }}
            aria-current={isCurrent(p.href) ? 'page' : undefined}
          >
            {p.label}
          </a>
        ))
      }
      <a class="external" href="https://github.com/verastack-labs/rigseed-app">
        Source
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7 17 17 7M9 7h8v8"></path>
        </svg>
      </a>
    </nav>
  </div>

  {
    /*
    Reading position as a progress bar, in the accent, the same shape the app
    draws for a downloading torrent.
  */
  }
  <div class="progress" aria-hidden="true"><span data-progress></span></div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')
  const links = document.querySelector<HTMLElement>('[data-links]')
  const indicator = document.querySelector<HTMLElement>('[data-indicator]')
  const progress = document.querySelector<HTMLElement>('[data-progress]')

  if (nav && links && indicator && progress) {
    // Low, so the surface arrives as soon as content starts passing under the
    // bar rather than after a deliberate scroll.
    const FLOOR = 24

    const pageLinks = Array.from(links.querySelectorAll<HTMLAnchorElement>('[data-page]'))
    const home = pageLinks.find((a) => a.classList.contains('is-current')) ?? null

    // Measured from the element rather than assumed from an index, so the
    // indicator stays correct when labels change width or the webfont loads
    // late and reflows them.
    const moveTo = (to: HTMLAnchorElement | null) => {
      if (!to) {
        indicator.style.opacity = '0'
        return
      }
      indicator.style.opacity = '1'
      indicator.style.transform = `translateX(${to.offsetLeft}px)`
      indicator.style.width = `${to.offsetWidth}px`
    }

    pageLinks.forEach((a) => {
      a.addEventListener('mouseenter', () => moveTo(a))
      a.addEventListener('focus', () => moveTo(a))
    })
    links.addEventListener('mouseleave', () => moveTo(home))
    links.addEventListener('focusout', (e) => {
      if (!links.contains(e.relatedTarget as Node)) moveTo(home)
    })

    let ticking = false
    const update = () => {
      const y = window.scrollY
      const max = document.documentElement.scrollHeight - window.innerHeight

      nav.classList.toggle('is-stuck', y > FLOOR)

      // Guard the divide: a page shorter than the viewport has max 0, and 0/0
      // is NaN, which silently leaves the bar at whatever it last was.
      progress.style.transform = `scaleX(${max > 0 ? Math.min(y / max, 1) : 0})`

      ticking = false
    }

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return
        ticking = true
        requestAnimationFrame(update)
      },
      { passive: true },
    )

    window.addEventListener('resize', () => {
      moveTo(home)
      update()
    })

    // The webfont swap changes label widths, so the first measurement can be
    // for the fallback. Re-measure once the real faces are in.
    if (document.fonts?.ready) document.fonts.ready.then(() => moveTo(home))

    moveTo(home)
    update()
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    transition:
      background-color var(--t-base) ease,
      border-color var(--t-base) ease;
    border-bottom: 1px solid transparent;
  }

  .is-stuck {
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    border-bottom-color: var(--line);
    backdrop-filter: blur(12px);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.8rem;
  }

  .links {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.15rem;
    font-size: 0.9375rem;
  }

  .links a {
    position: relative;
    z-index: 1;
    padding: 0.35rem 0.7rem;
    border-radius: var(--r-nav);
    color: var(--text-dim);
    text-decoration: none;
    transition: color var(--t-fast) ease;
  }

  .links a:hover,
  .links a.is-current {
    color: var(--text);
  }

  .external {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: 0.4rem;
  }

  .external svg {
    opacity: 0.55;
  }

  /* The segmented-control indicator. Spring on travel, plain ease on opacity,
     which is the same split the app uses. */
  .indicator {
    position: absolute;
    left: 0;
    top: 50%;
    height: 1.85rem;
    translate: 0 -50%;
    border-radius: var(--r-nav);
    background: var(--surface2);
    opacity: 0;
    pointer-events: none;
    transition:
      transform var(--t-base) var(--spring),
      width var(--t-base) var(--spring),
      opacity var(--t-fast) ease;
  }

  .progress {
    position: absolute;
    inset: auto 0 -1px;
    height: 2px;
    overflow: hidden;
  }

  .progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }

  /*
   * Under reduced motion nothing slides. The indicator still moves and the
   * progress line still fills, because both carry information, but they change
   * state rather than animate between them.
   */
  @media (prefers-reduced-motion: reduce) {
    .nav,
    .indicator {
      transition: none;
    }
  }

  @media (max-width: 40rem) {
    /* The indicator has nothing to rest under once the labels are this tight,
       and Source is the one link that still earns its width. */
    .indicator {
      display: none;
    }
    .links {
      font-size: 0.875rem;
    }
    .links a {
      padding-inline: 0.45rem;
    }
    /* The arrow is the first thing to go; the label still has to read. */
    .external svg {
      display: none;
    }
  }
</style>
