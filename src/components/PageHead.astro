---
interface Props {
  eyebrow: string
  title: string
  lede?: string
}
const { eyebrow, title, lede } = Astro.props
---

{
  /*
  The page header for everything that is not the homepage. Left-aligned and
  without an aura, deliberately: the centred block and the glow are the
  homepage's opening move, and repeating them on a utility page would spend the
  gesture until it stops meaning anything.
*/
}
<header class="page-head wrap">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
</header>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 0;
  }

  h1 {
    max-width: 18ch;
  }

  .lede {
    margin-top: 1.25rem;
    max-width: 56ch;
  }
</style>
