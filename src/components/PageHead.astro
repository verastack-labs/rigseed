---
interface Props {
  title: string
  lede?: string
}
const { title, lede } = Astro.props
---

{
  /*
  The page header for everything that is not the homepage. Left-aligned and
  without an aura, deliberately: the centred block and the glow are the
  homepage's opening move, and repeating them on a utility page would spend the
  gesture until it stops meaning anything.
*/
}
{
  /*
  No label above the heading. A small uppercase line announcing the heading
  underneath it is the kicker the craft floor refuses: it repeats what the
  heading already says, in a size nobody reads, and it is the single most
  reliable tell of a page assembled from a template.
*/
}
<header class="page-head wrap">
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
</header>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 0;
  }

  h1 {
    max-width: 18ch;
  }

  .lede {
    margin-top: 1.25rem;
    max-width: 56ch;
  }
</style>
