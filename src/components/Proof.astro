---
// Every claim here is checked against the app rather than written for the
// page. The credential generation is src-tauri/src/daemon.rs, the shortcuts
// are the bindings in src/pages/transfers.tsx, and the endpoint strip is what
// the screens actually print.
const points = [
  {
    title: 'The daemon comes with it',
    body: `qbittorrent-nox ships inside the app and starts with it, bound to loopback. On first
      launch rigseed generates its own WebUI credentials and writes them into the config, so there
      is no password to invent and no port to open.`,
  },
  {
    title: 'Your existing setup is where you left it',
    body: `rigseed reads and writes the same qBittorrent configuration the stock client uses.
      Categories, save paths, limits and trackers are the ones you already have. Go back to the old
      interface whenever you like and nothing has moved.`,
  },
  {
    title: 'The API stays visible',
    body: `Every screen prints the endpoints it drives, because a client that hides its transport
      is a client you cannot debug. What you see on screen is one call away from what you could
      make yourself with curl.`,
  },
]

// Transfers screen, exactly as bound. Written as the app labels them.
const keys = [
  { combo: ['/'], does: 'Focus the filter' },
  { combo: ['↑', '↓'], does: 'Move the cursor' },
  { combo: ['Space'], does: 'Pause or resume' },
  { combo: ['Enter'], does: 'Open the torrent' },
  { combo: ['Ctrl', 'A'], does: 'Select everything' },
  { combo: ['Esc'], does: 'Clear the selection' },
]
---

<section id="proof" class="wrap">
  <p class="eyebrow">What it actually does</p>
  <h2>A front end, and honest about being one.</h2>

  {
    /*
    Hairlines rather than cards. Three bordered boxes would say "three separate
    objects"; these are three parts of one argument, so they share a rule.
  */
  }
  <div class="grid">
    {
      points.map((p) => (
        <article class="point">
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </article>
      ))
    }
  </div>

  <div class="keys">
    <p class="keys-label mono">Transfers</p>
    <ul class="keys-list">
      {
        keys.map((k) => (
          <li>
            <span class="combo">
              {k.combo.map((c) => (
                <kbd>{c}</kbd>
              ))}
            </span>
            <span class="does">{k.does}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  h2 {
    max-width: 22ch;
    margin-bottom: 2.75rem;
  }

  .grid {
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--line);
  }

  .point {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--line);
  }

  .point h3 {
    margin-bottom: 0.625rem;
  }

  .point p {
    color: var(--text-dim);
    font-size: 0.9375rem;
    max-width: 58ch;
  }

  @media (min-width: 54rem) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      border-bottom: 1px solid var(--line);
    }

    .point {
      padding: 1.75rem 1.75rem 2rem 0;
      border-bottom: 0;
    }

    /* The rule between columns, drawn on the gap rather than around each
       column, so the row reads as one band with divisions in it. */
    .point + .point {
      border-left: 1px solid var(--line);
      padding-left: 1.75rem;
    }
  }

  .keys {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .keys-label {
    margin: 0;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dimmer);
  }

  .keys-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .keys-list li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-dim);
  }

  .combo {
    display: inline-flex;
    gap: 0.1875rem;
  }

  kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--line);
    /* The second border is the key's edge, which is what makes a kbd read as a
       key rather than as a bordered span. */
    border-bottom-width: 2px;
    border-radius: 5px;
    background: var(--surface);
    color: var(--text);
    font-size: 0.6875rem;
    line-height: 1.4;
  }
</style>
