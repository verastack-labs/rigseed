---
import { Image } from 'astro:assets'
import transfers from '../assets/screens/02-transfers-dark.png'
import easy from '../assets/screens/03-easy-dark.png'
import appearance from '../assets/screens/04-appearance-open.png'
import light from '../assets/screens/05-transfers-light.png'
import firstRun from '../assets/screens/01-first-run.png'

/*
 * The sticky tour. Copy scrolls on the left, one frame holds on the right and
 * cross-fades as each block takes the reading line.
 *
 * Every capture is the shipping app against its built-in sample data, which is
 * why the "Sample data" pill is visible in frame and stays there. Screenshots
 * of a real library on a page for a torrent client advertise whatever is in
 * it, and the sample data is what the product brief describes anyway: Linux
 * images, NASA photography, the Blender open movie collection.
 */
const steps = [
  {
    src: transfers,
    title: 'Transfers',
    body: `The screen you will have open. A sidebar of status filters, categories and tags, a live
      speed graph, and the list itself in whichever of the three densities you chose. Everything on
      it comes from one polled endpoint.`,
    endpoints: 'sync/maindata',
  },
  {
    src: easy,
    title: 'Easy, for people new to this',
    body: `Big cards, plain language, few numbers. "4 minutes left" rather than a rate and an ETA
      you have to combine yourself. It is a view rather than a lesser mode: the same data, the same
      actions, chosen during setup and switchable whenever.`,
    endpoints: 'sync/maindata',
  },
  {
    src: appearance,
    title: 'Appearance, applied live',
    body: `Eight accents and two modes. Changing either retints every surface in the window at once,
      because the neutrals are mixes of a base tone and the accent rather than fixed greys. Nothing
      reloads and nothing needs restarting.`,
    endpoints: 'local, never round-trips',
  },
  {
    src: light,
    title: 'Light, designed rather than inverted',
    body: `Both modes ship with all eight accents, and the tint strengths differ per mode so a
      surface reads at the same weight in either. Paper white with a soft tint, not charcoal with
      the numbers flipped.`,
    endpoints: 'torrents/info',
  },
  {
    src: firstRun,
    title: 'A first launch that asks',
    body: `Where files go, how fast to go, and what to seed, each sitting beside the sentence that
      says what it does. The stock client has never had this. All of it is changeable later, and
      none of it blocks you from skipping ahead.`,
    endpoints: 'app/preferences',
  },
]
---

<section class="tour wrap" aria-label="A tour of the main screens">
  <ol class="steps">
    {
      steps.map((s, i) => (
        <li class="step" data-step={i}>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
          <p class="endpoints mono">{s.endpoints}</p>

          {/*
            The frame repeats inside each step for narrow viewports, where
            there is no second column to be sticky in. One of the two copies is
            always display:none, so only one ever loads a decode.
          */}
          <div class="inline-frame">
            <Image
              src={s.src}
              alt={s.title}
              widths={[720, 1080, 1440]}
              sizes="100vw"
              quality={90}
              loading="lazy"
              class="shot"
            />
          </div>
        </li>
      ))
    }
  </ol>

  <div class="stack-col" aria-hidden="true">
    <div class="stack">
      {
        steps.map((s, i) => (
          <Image
            src={s.src}
            alt=""
            widths={[720, 1080, 1440, 2048]}
            sizes="(min-width: 64rem) 40rem, 100vw"
            quality={90}
            loading={i === 0 ? 'eager' : 'lazy'}
            class:list={['shot', 'layer', { 'is-on': i === 0 }]}
            data-layer={i}
          />
        ))
      }
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('.tour')
  const steps = Array.from(document.querySelectorAll<HTMLElement>('[data-step]'))
  const layers = Array.from(document.querySelectorAll<HTMLElement>('[data-layer]'))

  if (section && steps.length && layers.length) {
    let shown = 0

    const show = (i: number) => {
      if (i === shown) return
      shown = i
      layers.forEach((l, n) => l.classList.toggle('is-on', n === i))
      steps.forEach((s, n) => s.classList.toggle('is-active', n === i))
    }

    // Which step owns the reading line. The one whose top is nearest above it
    // wins, which behaves correctly for steps shorter than the viewport where
    // an intersection ratio flickers between two neighbours.
    let ticking = false
    const update = () => {
      const line = window.scrollY + window.innerHeight * 0.45
      let found = 0
      steps.forEach((s, n) => {
        if (s.offsetTop <= line) found = n
      })
      show(found)
      ticking = false
    }

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return
        ticking = true
        requestAnimationFrame(update)
      },
      { passive: true },
    )
    window.addEventListener('resize', update)

    steps[0]?.classList.add('is-active')
    update()
  }
</script>

<style>
  .tour {
    display: grid;
    gap: 0;
    align-items: start;
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    padding-block: clamp(2rem, 5vw, 3rem);
    border-bottom: 1px solid var(--line);
  }

  .step:last-child {
    border-bottom: 0;
  }

  .step h3 {
    margin-bottom: 0.625rem;
  }

  .step p {
    color: var(--text-dim);
    font-size: 0.9375rem;
    max-width: 52ch;
  }

  .endpoints {
    margin-top: 1rem;
    color: var(--text-dimmer);
    font-size: 0.75rem;
  }

  .shot {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
  }

  .inline-frame {
    margin-top: 1.5rem;
  }

  .stack-col {
    display: none;
  }

  @media (min-width: 64rem) {
    .tour {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: clamp(2.5rem, 5vw, 4.5rem);
    }

    /* One frame on the right, held in place while the copy goes past it. The
       offset clears the nav, which is sticky at the top of the same scroll. */
    .stack-col {
      display: block;
      position: sticky;
      top: 5.5rem;
    }

    .inline-frame {
      display: none;
    }

    .stack {
      position: relative;
      /* The tallest capture sets the height, so the frame never resizes as the
         layers swap and the copy beside it never reflows. */
      display: grid;
    }

    .layer {
      grid-area: 1 / 1;
      opacity: 0;
      transition: opacity var(--t-slow) ease;
      box-shadow: 0 1.5rem 4rem -1.5rem color-mix(in srgb, var(--accent) 26%, transparent);
    }

    .layer.is-on {
      opacity: 1;
    }

    /* Inactive copy recedes rather than disappearing. It is still readable if
       you look at it, which matters: this is the page's actual content, not a
       progressive-reveal effect. */
    .step {
      opacity: 0.5;
      transition: opacity var(--t-slow) ease;
      border-bottom: 0;
      /* Each step gets most of a viewport so the frame has something to hold
         through. Padding rather than min-height, so a long block still grows. */
      padding-block: clamp(4rem, 14vh, 8rem);
    }

    .step.is-active {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .layer,
    .step {
      transition: none;
    }
  }
</style>
