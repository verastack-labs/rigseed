---
import { Image } from 'astro:assets'
import easy from '../assets/screens/03-easy-dark.png'
import light from '../assets/screens/05-transfers-light.png'
import firstRun from '../assets/screens/01-first-run.png'

// Numbers are never dressed up, and no screenshot is presented as something it
// is not. These are the real app against its built-in sample data, which is
// why the "Sample data" pill is visible in frame and stays there.
const shots = [
  {
    src: firstRun,
    title: 'It asks before it assumes',
    body: 'Mode, accent and default layout are chosen on first launch, before anything else happens. The stock client has never had this. All of it is changeable later in Settings.',
    endpoints: 'app/preferences',
  },
  {
    src: easy,
    title: 'Easy layout for people new to this',
    body: 'Big cards, plain language, few numbers. "4 minutes left" instead of a rate and an ETA. Chosen during setup and switchable at any time, so it is a view rather than a lesser mode.',
    endpoints: 'sync/maindata',
  },
  {
    src: light,
    title: 'Light is not an afterthought',
    body: 'Both modes ship with all eight accents, and the tint strengths differ per mode so a surface reads the same weight in either. Paper white with a soft tint, not inverted charcoal.',
    endpoints: 'torrents/info',
  },
]
---

<section id="screens" class="wrap">
  <p class="eyebrow">Screens</p>
  <h2>Nine screens, drawn before they were built.</h2>
  <p class="lede">
    Every one states the API endpoints it exercises in a small mono line. That is deliberate: it
    doubles as documentation, and a screen that cannot name its endpoint usually does not know what
    it is doing.
  </p>

  <div class="rows">
    {
      shots.map((shot, i) => (
        <article class="row" data-flip={i % 2 === 1 ? 'true' : 'false'}>
          <div class="copy">
            <h3>{shot.title}</h3>
            <p>{shot.body}</p>
            <p class="endpoints mono">{shot.endpoints}</p>
          </div>
          <div class="frame">
            <Image
              src={shot.src}
              alt={shot.title}
              widths={[720, 1080, 1440, 2048]}
              sizes="(min-width: 60rem) 34rem, 100vw"
              quality={90}
              loading="lazy"
              class="shot"
            />
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  h2 {
    max-width: 18ch;
  }

  .lede {
    margin-top: 1rem;
    max-width: 52ch;
  }

  .rows {
    display: grid;
    gap: clamp(3rem, 7vw, 5.5rem);
    margin-top: clamp(3rem, 7vw, 4.5rem);
  }

  .row {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .row {
      grid-template-columns: 1fr 1.15fr;
    }
    /* The image leads on alternate rows. Ordering rather than direction, so
       the reading order in the DOM stays copy-then-image for a screen reader. */
    .row[data-flip='true'] .copy {
      order: 2;
    }
  }

  h3 {
    color: var(--text);
  }

  .copy p {
    margin-top: 0.75rem;
    color: var(--text-dim);
    max-width: 46ch;
  }

  .endpoints {
    margin-top: 1rem;
    color: var(--text-dimmer);
    font-size: 0.75rem;
  }

  .frame {
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .shot {
    width: 100%;
    display: block;
  }
</style>
