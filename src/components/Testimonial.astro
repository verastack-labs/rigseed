---
import { Image } from 'astro:assets'
import portrait from '../assets/people/artto.jpg'

/*
 * The first outside test, in the tester's own words.
 *
 * One voice, set as one voice. The instinct with a testimonial section is a
 * grid of three cards, and with a single report that grid either sits
 * two-thirds empty or gets padded out with things somebody did not quite say.
 * A named, linkable person quoted verbatim is the honest form of this; a wall
 * of anonymous praise is not.
 *
 * The quotes are verbatim, capitals included. "REALLY" and "FLAWLESS" are his
 * emphasis, not a designer's, and leaving them as typed is the difference
 * between a quotation and a rewrite. It also happens to be the tell that these
 * are somebody's actual messages rather than copy written to sound like them.
 *
 * The platform is in his own sentence, so the attribution does not repeat it.
 * An earlier version of this section carried a line underneath announcing that
 * exactly one person outside the project had tested it and listing the bug he
 * found. That was honesty misapplied: not overstating is a rule about claims,
 * and neither a user count nor a bug list is a claim this section makes. Faults
 * belong in the issue tracker, which is linked from every page.
 */

/* Verbatim, from the messages. Do not tidy the capitals. */
const quote =
  'I was REALLY trying to find something that bugs me or irritates or is somewhat not working… found pretty much nothing.'
const second = 'Everything in my experience on my Debian machine has been FLAWLESS.'

const person = {
  name: 'Artto Aunap',
  role: 'GNU/Linux automation developer',
  url: 'https://artto.name',
}
---

<section id="testimonial" class="wrap">
  <figure class="block">
    <blockquote>
      <p class="lead">{quote}</p>
      <p class="second">{second}</p>
    </blockquote>

    <figcaption class="by">
      {
        /*
        Decorative, so the alt is empty: his name sits beside it in text, and a
        second reading of "Artto Aunap" helps nobody. Sized at twice its drawn
        width so it stays sharp on a dense display.
      */
      }
      <Image
        class="avatar"
        src={portrait}
        alt=""
        width={80}
        height={80}
        quality={88}
        loading="lazy"
      />

      <span class="who">
        <a class="name" href={person.url} rel="noopener noreferrer" target="_blank">
          {person.name}
        </a>
        <span class="role">{person.role}</span>
      </span>
    </figcaption>
  </figure>
</section>

<style>
  .block {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    /* A rule above and below rather than a card. The section is a held breath
       between the theming demonstration and the download, and a bordered box
       would make it one more panel in a page that already has several. */
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  blockquote {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 30ch;
  }

  .lead {
    margin: 0;
    font-family: 'Archivo', 'Inter Variable', ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.4rem, 3.4vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.028em;
    line-height: 1.2;
    text-wrap: balance;
    color: var(--text);
  }

  .second {
    margin: 0;
    max-width: 46ch;
    font-size: 0.9375rem;
    color: var(--text-dim);
  }

  .by {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .avatar {
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    /* The ground behind a photograph, so a portrait with a pale background does
       not float against the page with no edge of its own. */
    border: 1px solid var(--line);
    background: var(--surface2);
  }

  .who {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    width: fit-content;
    border-bottom: 1px solid transparent;
    transition: border-color var(--t-fast) ease;
  }

  .name:hover {
    border-bottom-color: var(--accent);
  }

  .role {
    font-size: 0.8125rem;
    color: var(--text-dimmer);
  }
</style>
