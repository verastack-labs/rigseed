---
// The accents, copied from the canonical table so keys and labels match the
// app exactly. Each swatch sets its own data-accent, so the dot inside it
// resolves --accent from tokens.css rather than repeating a hex here. The
// colours cannot drift from the app because they are never written twice.
const accents = [
  { key: 'dustblue', label: 'Dusty Blue' },
  { key: 'amber', label: 'Amber' },
  { key: 'sage', label: 'Sage' },
  { key: 'terracotta', label: 'Terracotta' },
  { key: 'mustard', label: 'Mustard' },
  { key: 'slateteal', label: 'Slate Teal' },
  { key: 'lavender', label: 'Lavender' },
  { key: 'slate', label: 'Slate' },
]
---

<section id="theming" class="wrap">
  <p class="eyebrow">Theming</p>
  <h2>The accent is a reskin, not a highlight.</h2>
  <p class="lede">
    Picking one does not recolour a few buttons. Every neutral surface is a mix of its base tone and
    the accent, so the page you are reading retints with it. These are the app's eight accents and
    the app's own two-stage mix, running here on a colder ground than the app uses, so this is the
    mechanism itself rather than a picture of it.
  </p>

  <div class="panel" data-panel>
    {
      /*
      A pointer that is not the visitor's. It runs once, the first time the
      panel is on screen, moves to two swatches and clicks them, so the row
      reads as a control rather than as a legend. It stops the moment a real
      pointer arrives, and it never writes the demonstrated accent to storage,
      because the visitor did not choose it.
    */
    }
    <span class="ghost" data-ghost aria-hidden="true">
      <svg width="20" height="22" viewBox="0 0 20 22" fill="none">
        <path
          d="M2 1.6 17 11.2l-6.4 1.1L7.3 19 2 1.6Z"
          fill="var(--text)"
          stroke="var(--bg)"
          stroke-width="1.4"
          stroke-linejoin="round"></path>
      </svg>
    </span>
    {
      /*
      A sibling of the pointer, not a child of it. The pointer is absolutely
      positioned, so it is its own containing block, and a ring nested inside
      it would take the pointer's offset once from the layout and once again
      from its own transform.
    */
    }
    <span class="ping" data-ping aria-hidden="true"></span>

    <div class="controls">
      <div class="group" role="group" aria-label="Accent">
        {
          accents.map((a) => (
            <button class="swatch" data-accent-set={a.key} data-accent={a.key} aria-label={a.label}>
              <span class="dot" />
            </button>
          ))
        }
      </div>

      <div class="group modes" role="group" aria-label="Mode">
        <button class="mode" data-mode-set="dark">Dark</button>
        <button class="mode" data-mode-set="light">Light</button>
      </div>
    </div>

    <div class="demo">
      <div class="card">
        <span class="name">ubuntu-24.04.2-desktop-amd64.iso</span>
        <div class="state"><span class="dot-sm"></span> downloading</div>
        <div class="bar"><span style="width: 72%"></span></div>
        <div class="figures mono">
          <span class="down">4.6 MB/s</span>
          <span class="up">137.6 KB/s</span>
          <span class="pct">72.0%</span>
        </div>
      </div>

      <div class="card">
        <span class="name">debian-12.9.0-amd64-netinst.iso</span>
        <div class="state"><span class="dot-sm up-dot"></span> seeding</div>
        <div class="bar"><span class="full" style="width: 100%"></span></div>
        <div class="figures mono">
          <span class="down">0 B/s</span>
          <span class="up">1.4 MB/s</span>
          <span class="pct">100%</span>
        </div>
      </div>

      <div class="card">
        <span class="name dim-name">archlinux-2026.08.01-x86_64.iso</span>
        <div class="state dim"><span class="dot-sm dim-dot"></span> paused</div>
        <div class="bar"><span class="dim-bar" style="width: 89%"></span></div>
        <div class="figures mono dim">
          <span>0 B/s</span>
          <span>0 B/s</span>
          <span class="pct">89.2%</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // No React here on purpose. A theme change is one attribute write, and
  // hydrating a component to perform a dataset assignment would cost more than
  // the assignment does.
  const root = document.documentElement

  const store = (key: string, value: string) => {
    try {
      localStorage.setItem('rigseed:' + key, value)
    } catch {
      // Storage blocked. The choice still applies for this visit, which is the
      // part that matters. Only remembering it is lost.
    }
  }

  const sync = () => {
    document.querySelectorAll<HTMLElement>('[data-accent-set]').forEach((el) => {
      el.setAttribute('aria-pressed', String(el.dataset.accentSet === root.dataset.accent))
    })
    document.querySelectorAll<HTMLElement>('[data-mode-set]').forEach((el) => {
      el.setAttribute('aria-pressed', String(el.dataset.modeSet === root.dataset.mode))
    })
  }

  // Split out so the demonstration can change the accent without persisting
  // it. A visitor who watched a pointer they do not control pick a colour has
  // not chosen that colour, and writing it to storage would mean they arrive
  // next time wearing it.
  const applyAccent = (next: string, persist: boolean) => {
    root.dataset.accent = next
    if (persist) store('accent', next)
    sync()
  }

  const swatches = Array.from(document.querySelectorAll<HTMLElement>('[data-accent-set]'))

  swatches.forEach((el) => {
    el.addEventListener('click', () => {
      const next = el.dataset.accentSet
      if (!next) return
      applyAccent(next, true)
    })
  })

  document.querySelectorAll<HTMLElement>('[data-mode-set]').forEach((el) => {
    el.addEventListener('click', () => {
      const next = el.dataset.modeSet
      if (!next) return
      root.dataset.mode = next
      store('mode', next)
      sync()
    })
  })

  sync()

  /*
   * The guided pointer.
   *
   * The swatch row is the one genuinely interactive thing on this page, and a
   * row of coloured dots reads as a legend until something moves. So a pointer
   * that is not the visitor's walks to two of them and clicks.
   *
   * Rules it follows. It runs once. It yields instantly to a real pointer,
   * because a demonstration competing with the person it is for is worse than
   * no demonstration. It does not persist what it picks. And it does not run
   * at all under reduced motion, where a cursor flying across the screen is
   * exactly the thing that setting is asking us not to do.
   */
  const panel = document.querySelector<HTMLElement>('[data-panel]')
  const ghost = document.querySelector<HTMLElement>('[data-ghost]')
  const ping = document.querySelector<HTMLElement>('[data-ping]')
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)')
  const coarse = window.matchMedia('(pointer: coarse)')

  if (panel && ghost && ping && !calm.matches && !coarse.matches && swatches.length > 4) {
    const original = root.dataset.accent ?? 'dustblue'
    let cancelled = false
    let timers: number[] = []

    const stop = () => {
      if (cancelled) return
      cancelled = true
      timers.forEach(clearTimeout)
      timers = []
      ghost.classList.remove('is-on')
    }

    // Any real intent ends it. Pointer movement over the panel, a touch, a
    // key, or a click anywhere in it.
    panel.addEventListener('pointerdown', stop)
    panel.addEventListener('pointermove', stop, { once: true })
    window.addEventListener('keydown', stop, { once: true })

    const at = (el: HTMLElement) => {
      const p = panel.getBoundingClientRect()
      const r = el.getBoundingClientRect()
      return {
        x: r.left - p.left + r.width / 2,
        y: r.top - p.top + r.height / 2,
      }
    }

    const after = (ms: number, run: () => void) => {
      timers.push(window.setTimeout(run, ms) as unknown as number)
    }

    const moveTo = (el: HTMLElement) => {
      const { x, y } = at(el)
      ghost.style.transform = `translate3d(${x}px, ${y}px, 0)`
      ping.style.transform = `translate3d(${x}px, ${y}px, 0) scale(0.3)`
    }

    const clickAt = (el: HTMLElement) => {
      const key = el.dataset.accentSet
      if (!key || cancelled) return
      ghost.classList.add('is-pressed')
      ping.classList.remove('is-firing')
      // Reading offsetWidth restarts the animation; without it the class is
      // removed and re-added inside one frame and nothing replays.
      void ping.offsetWidth
      ping.classList.add('is-firing')
      applyAccent(key, false)
      after(150, () => ghost.classList.remove('is-pressed'))
    }

    // Two accents far apart in hue, so the retint is obvious rather than
    // subtle. Neither is the one the page arrived wearing.
    const first = swatches.find((s) => s.dataset.accentSet === 'terracotta') ?? swatches[3]
    const second = swatches.find((s) => s.dataset.accentSet === 'sage') ?? swatches[2]

    const run = () => {
      if (cancelled) return
      moveTo(swatches[0])
      ghost.classList.add('is-on')

      after(420, () => moveTo(first))
      after(1180, () => clickAt(first))
      after(1900, () => moveTo(second))
      after(2620, () => clickAt(second))
      after(3400, () => {
        ghost.classList.remove('is-on')
        // Put back what the visitor actually had, so nothing was decided for
        // them. Late enough that the last swatch was clearly seen to work.
        after(500, () => applyAccent(original, false))
      })
    }

    const watcher = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          watcher.disconnect()
          // A beat after it lands, so the pointer is not already moving while
          // the section is still sliding into place.
          after(500, run)
        }
      },
      { threshold: 0.55 },
    )
    watcher.observe(panel)
  }
</script>

<style>
  h2 {
    max-width: 20ch;
  }

  .lede {
    margin-top: 1rem;
    max-width: 54ch;
  }

  .panel {
    position: relative;
    margin-top: clamp(2rem, 5vw, 3rem);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  /*
   * The guided pointer. Both it and its click ring are positioned from the
   * panel's top left corner and moved with a transform, so neither one ever
   * triggers layout while it travels.
   *
   * The arrow is drawn in the text colour with a stroke in the page colour
   * around it, which is how a real cursor stays visible over whatever it
   * happens to be passing over.
   */
  .ghost {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    display: block;
    opacity: 0;
    pointer-events: none;
    /* The tip of the arrow sits at the coordinate, not its centre, which is
       where a real pointer's hotspot is. */
    margin: -2px 0 0 -2px;
    transition:
      transform 0.62s cubic-bezier(0.32, 0.72, 0.3, 1),
      opacity var(--t-base) ease;
  }

  .ghost.is-on {
    opacity: 1;
  }

  .ghost svg {
    display: block;
    transition: transform var(--t-fast) ease;
  }

  /* The press. A real cursor does not change, so the arrow dips instead,
     which reads as the click without inventing a cursor state. */
  .ghost.is-pressed svg {
    transform: translate(1px, 1px) scale(0.88);
  }

  .ping {
    position: absolute;
    top: 0;
    left: 0;
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    border-radius: 50%;
    border: 1.5px solid var(--accent);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.62s cubic-bezier(0.32, 0.72, 0.3, 1);
  }

  .ping.is-firing {
    animation: ping 0.5s ease-out;
  }

  @keyframes ping {
    from {
      opacity: 0.9;
      scale: 0.35;
    }
    to {
      opacity: 0;
      scale: 1.15;
    }
  }

  /* It never runs under either of these, but the styles are guarded anyway so
     a stuck class cannot leave something animating. */
  @media (prefers-reduced-motion: reduce) {
    .ghost,
    .ghost svg,
    .ping {
      transition: none;
      animation: none;
    }
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }

  .group {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .swatch {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 999px;
    background: none;
    cursor: pointer;
    transition:
      border-color var(--t-fast) ease,
      transform var(--t-fast) var(--spring);
  }

  .swatch:hover {
    transform: scale(1.1);
  }

  .swatch[aria-pressed='true'] {
    border-color: var(--text-dim);
  }

  .dot {
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: var(--accent);
    display: block;
  }

  .modes {
    border: 1px solid var(--line);
    border-radius: var(--r-nav);
    padding: 3px;
    gap: 2px;
  }

  .mode {
    border: 0;
    background: none;
    color: var(--text-dim);
    font: inherit;
    font-size: 0.875rem;
    padding: 0.3rem 0.85rem;
    border-radius: 7px;
    cursor: pointer;
    transition:
      background-color var(--t-fast) ease,
      color var(--t-fast) ease;
  }

  .mode[aria-pressed='true'] {
    background: var(--surface2);
    color: var(--text);
  }

  .demo {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .card {
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--surface2);
    padding: 0.875rem 1rem 1rem;
  }

  .name {
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: block;
  }

  /* Paused is never accent. Attention is a scarce resource spent on live
     things, so a paused row gives its colour back. */
  .dim-name {
    color: var(--text-dim);
  }

  .state {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.6rem;
    font-size: 0.8125rem;
    color: var(--text-dim);
  }

  .dot-sm {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--accent);
  }

  .up-dot {
    background: var(--accent2);
  }

  .dim-dot {
    background: var(--text-dimmer);
  }

  .bar {
    height: 4px;
    border-radius: 999px;
    background: var(--surface);
    margin-top: 0.7rem;
    overflow: hidden;
  }

  .bar span {
    display: block;
    height: 100%;
    background: var(--accent);
    border-radius: 999px;
  }

  .bar .full {
    background: var(--accent2);
  }

  .bar .dim-bar {
    background: var(--text-dimmer);
  }

  .figures {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.7rem;
    font-size: 0.75rem;
  }

  .down {
    color: var(--accent);
  }

  .up {
    color: var(--accent2);
  }

  .pct {
    margin-left: auto;
    color: var(--text-dim);
  }

  .dim,
  .dim span {
    color: var(--text-dimmer);
  }
</style>
