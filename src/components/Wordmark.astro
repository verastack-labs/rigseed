---
import Mark from './Mark.astro'

interface Props {
  /** Cap height of the script, in rem. The seedling scales from it. */
  size?: number
  /** Renders a span rather than a link, for the footer and the nav's own page. */
  as?: 'a' | 'span'
  class?: string
}

const { size = 1.5, as = 'a', class: className } = Astro.props
const base = import.meta.env.BASE_URL
const Tag = as
---

{
  /*
  The seedling stays in the accent and the script stays in the text colour,
  which is the relationship the app uses between its icon and its title. The
  script is the only characterful face in the system, so it earns its place by
  being the single thing on the page set in it.
*/
}
<Tag
  class:list={['wordmark', className]}
  href={as === 'a' ? base : undefined}
  style={`--wm-size:${size}rem`}
>
  <Mark size={Math.round(size * 15)} class="wordmark-leaf" />
  <span class="wordmark-name">rigseed</span>
</Tag>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-size: var(--wm-size);
    color: var(--accent);
    text-decoration: none;
    line-height: 1;
  }

  .wordmark-name {
    font-family: 'Yellowtail', 'Brush Script MT', cursive;
    font-size: 1em;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--text);
    /* Yellowtail sits high in its em box and carries a long descender on the
       g. Nudging it down puts the x-height on the same optical line as the
       seedling instead of floating above it. */
    transform: translateY(0.08em);
  }

  /* The leaf is a hair below the script's optical centre without this, because
     the script's visual mass sits above its baseline. */
  .wordmark-leaf {
    transform: translateY(-0.04em);
  }

  .wordmark:hover .wordmark-name {
    color: var(--accent);
  }

  .wordmark-name,
  .wordmark-leaf {
    transition: color var(--t-base) ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .wordmark-name,
    .wordmark-leaf {
      transition: none;
    }
  }
</style>
