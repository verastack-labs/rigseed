---
import '@fontsource-variable/inter'
import '@fontsource/jetbrains-mono/400.css'
import '@fontsource/jetbrains-mono/500.css'
// The one characterful face in the system, and it is spent entirely on the
// wordmark. Everything else stays Inter and JetBrains Mono, which is what the
// app uses; a second display face would make the site a different product.
import '@fontsource/yellowtail'
import '../styles/tokens.css'
// After tokens, because it overrides the base neutrals those tokens mix the
// accent into. Before base.css, which only consumes the result.
import '../styles/site-theme.css'
import '../styles/base.css'
import { ClientRouter } from 'astro:transitions'
import StructuredData from '../components/StructuredData.astro'

interface Props {
  title: string
  description: string
  version: string
  releaseUrl: string
}

const { title, description, version, releaseUrl } = Astro.props
/*
 * The social card, resolved against the site root rather than the current page.
 *
 * This was `new URL('social.png', Astro.site + Astro.url.pathname)`, which is
 * relative to whatever page is rendering: the homepage got the right URL and
 * every other page pointed at a file beside itself that has never existed. The
 * image lives once, in public/, so the URL is built once from the base.
 */
const social = new URL(
  `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/social.png`,
  Astro.site,
).toString()

// One canonical URL per page. Without it the same page is reachable with and
// without a trailing slash and a crawler has to guess which is authoritative.
const canonical = new URL(Astro.url.pathname, Astro.site).toString()
---

<!doctype html>
<!--
  Mode and accent are attributes on the root, exactly as the app does it, so a
  theme change is one attribute write and never a recomputation in JS. Dark and
  dustblue are the app's own defaults.
-->
<html lang="en" data-mode="dark" data-accent="dustblue">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={social} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- The chrome around the page follows the theme, so the browser's own UI
         does not sit at a different brightness from the page under it. -->
    <meta name="theme-color" content="#05080e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f6f9" media="(prefers-color-scheme: light)" />

    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`} type="image/svg+xml" />

    <!--
      The chosen accent and mode are read before first paint. Anything later
      shows the default for a frame and then swaps, which is the flash this
      exists to avoid. Wrapped because a browser with storage blocked throws
      here rather than returning null, and losing the whole page to a theme
      preference would be a poor trade.
    -->
    <script is:inline>
      const applyTheme = () => {
        try {
          const mode = localStorage.getItem('rigseed:mode')
          const accent = localStorage.getItem('rigseed:accent')
          if (mode) document.documentElement.dataset.mode = mode
          if (accent) document.documentElement.dataset.accent = accent
        } catch {}
      }
      applyTheme()

      /*
       * The wordmark waits for its own face.
       *
       * Yellowtail is loaded with font-display: swap, so the name paints in
       * whatever cursive the machine has and then jumps to the real face a
       * moment later. On a word this distinctive, at this size, that jump is
       * the first thing a visitor sees the site do.
       *
       * So the name is held invisible, not absent: it still takes its space,
       * so nothing around it moves, and it simply arrives once. If the font
       * fails or is slow, it is revealed anyway after a second and a half,
       * because a permanently invisible wordmark is a worse outcome than a
       * substituted one.
       */
      var FONT_READY = 'wordmark-ready'
      var fontReady = false
      var showWordmark = function () {
        fontReady = true
        document.documentElement.classList.add(FONT_READY)
      }

      if (document.fonts && document.fonts.load) {
        document.fonts.load('1rem Yellowtail').then(showWordmark).catch(showWordmark)
        setTimeout(showWordmark, 1500)
      } else {
        showWordmark()
      }

      // The router copies the incoming document's html attributes over the
      // live ones, which includes data-mode, data-accent and this class, so a
      // visitor who picked an accent would lose it the moment they opened
      // another page and the wordmark would hide itself again. after-swap runs
      // with the new DOM in place and before it is painted.
      document.addEventListener('astro:after-swap', function () {
        applyTheme()
        if (fontReady) document.documentElement.classList.add(FONT_READY)
      })
    </script>
    <!--
      Turns the site from a set of documents into one shell that swaps its
      contents. Without it every navigation is a full document load: the nav is
      rebuilt, its scroll state is lost, and the page goes blank in between.
      With it, anything marked transition:persist survives the swap as the same
      live DOM node, which is what the nav does.
    -->
    <ClientRouter />
    <StructuredData version={version} releaseUrl={releaseUrl} />
  </head>
  <body>
    <!--
      DIRECTION CONTRACT

      THESIS: a front end is only worth switching to if you can watch it work,
      so the running transfer list is the first viewport at full width; this
      page refuses the three-icon feature grid above the fold.
      OWN-WORLD: a cold near-navy ground with bright text, the app's own eight
      accents tinting every surface through the app's own two-stage mix;
      hairline rules rather than cards, mono for every number, and the Yellowtail
      script reserved for the name itself, in the wordmark and in the headline.
      STORY: this is qBittorrent's own engine behind a new interface, there is
      nothing to install first, and the download is one click from here.
      FIRST VIEWPORT: a contracting glass bar, a status pill, a 16ch headline
      naming the thing itself, the technical claim demoted beneath it with the
      name in script, one small line for the qBittorrent relationship, paired
      buttons with Download primary, then the whole transfers surface at 62rem,
      laid back 14 degrees on an accent aura, standing up as they scroll.
      FORM: the category standard played straight at the Linear and Raycast
      craft bar, taken as the standing exit over roll 33e09191 index 6.
      FINISH: unreviewed and undocumented is unfinished; this build ends with
      the finish review, the verdict, and DESIGN.md
    -->
    <slot />
  </body>
</html>
