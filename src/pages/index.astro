---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Hero from '../components/Hero.astro'
import Comparison from '../components/Comparison.astro'
import Proof from '../components/Proof.astro'
import Statement from '../components/Statement.astro'
import Pipeline from '../components/Pipeline.astro'
import Theming from '../components/Theming.astro'
import Close from '../components/Close.astro'
import Footer from '../components/Footer.astro'

const version = '0.1.2'
---

<Base
  title="rigseed, a desktop client for qBittorrent"
  description="rigseed puts a modern interface on qBittorrent, driving the daemon over the Web API it already exposes. Windows, macOS and Linux."
  version={version}
  releaseUrl="https://github.com/verastack-labs/rigseed-app/releases/latest"
>
  {
    /*
    The scroll is paced rather than stacked. The hero is loud and the surface
    runs off its bottom edge; Proof is dense and quiet, all hairlines and small
    type; Comparison is the proof, and it sits second because showing the thing
    beats describing it; Statement is the breath after that, one sentence and a great deal of
    quiet; Pipeline is the one diagram, carrying the only ambient motion on the
    page after the hero; Theming is the interactive moment, where the page
    itself changes colour under the reader; then the close is loud again and
    anchors the end.
  */
  }
  <Nav />
  <Hero />
  <Comparison />
  <Proof />
  <Statement />
  <Pipeline />
  <Theming />
  <Close version={`v${version}`} />
  <Footer />
</Base>
